<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Warna background (mirip Compose putih keabu) -->
    <solid android:color="#EDE7F6"/>

    <!-- Sudut rounded -->
    <corners android:radius="12dp"/>

    <!-- Optional: garis tipis bawah biar lebih realistis -->
    <stroke
        android:width="1dp"
        android:color="#D1C4E9"/>

    <!-- Padding dalam -->
    <padding
        android:left="8dp"
        android:right="8dp"
        android:top="4dp"
        android:bottom="4dp"/>

</shape>